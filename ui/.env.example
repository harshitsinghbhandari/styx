# Server-side only (no VITE_ prefix, never reaches the client bundle): the
# dev proxy target (see vite.config.ts). Leave unset for the default,
# http://localhost:4000, which matches kernel/src/api/start.ts's default PORT.
API_PROXY_TARGET=http://localhost:4000

# Client-side. Leave UNSET in dev and behind the Fargate deploy: an unset
# value means "fetch same-origin" (relative /v1/... paths), which is what
# both the dev proxy above and the prod same-origin deploy want. Only set
# this to point the built app at a different API origin, and note that then
# needs the kernel's own CORS story, which is out of scope for ui/.
VITE_API_URL=

# Demo agent API key (Bearer token). Every kernel route except /v1/health
# requires auth, including the SSE stream, so the console needs one agent's
# key to read anything. Fine for a hackathon demo; not a real auth story.
# scripts/seed.ts prints one per agent on stdout. A key can also be pasted
# into the header's key field at runtime (stored in localStorage), which
# takes priority over this env value.
VITE_STYX_API_KEY=
